[Unit]
Description=Daily server health report to Telegram
After=network.target postgresql.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/var/www/jaysonkhan
ExecStart=/var/www/jaysonkhan/backend/venv/bin/python /var/www/jaysonkhan/backend/manage.py server_health_report --tariff
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
