# ==============================================================================
# JaysonKhan Portfolio V2 - Environment Configuration Example
# ==============================================================================
# Link: https://github.com/jaysonkhan/jaysonkhan_v2
#
# This file serves as a template for your local .env file.
# Duplicate this file as '.env' and fill in the actual values.
#
# IMPORTANT: Never commit the actual .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Use a strong secret key for production. Generate one with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Set to False in production!
DJANGO_DEBUG=True

# List of host/domain names that this Django site can serve.
# Example: .jaysonkhan.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ⚠️  SECURITY: Change this in production to something unpredictable!
# Example: ADMIN_URL=jk-secret-control-2026/
# Leaving it as 'admin/' makes your admin panel trivially discoverable.
ADMIN_URL=admin/

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Or use individual variables if your settings.py is configured to parse them.
# DATABASE_URL=postgres://portfolio_user:strong_password@localhost:5432/portfolio_db

# Individual Postgres Settings
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLite fallback (For local development only)
# DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# 3. Authentication (Simple JWT)
# ------------------------------------------------------------------------------
# Token lifetimes in minutes (Access) and days (Refresh)
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=30

# ------------------------------------------------------------------------------
# 3b. Telegram Login Widget
# ------------------------------------------------------------------------------
# Get these from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN is used to verify Login Widget hash signatures (server-side, never expose to frontend)
# TELEGRAM_BOT_USERNAME is the public bot username shown in the widget (no @)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=YourBotUsername

# ------------------------------------------------------------------------------
# 4. Email Configuration
# ------------------------------------------------------------------------------
# Use 'django.core.mail.backends.smtp.EmailBackend' for production
# Use 'django.core.mail.backends.console.EmailBackend' for local testing
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ------------------------------------------------------------------------------
# 5. Static & Media Files
# ------------------------------------------------------------------------------
# For production (Nginx/Gunicorn setup)
# STATIC_ROOT=/var/www/jaysonkhan/static
# MEDIA_ROOT=/var/www/jaysonkhan/media

# For local development (must differ from STATICFILES_DIRS = backend/static/)
STATIC_ROOT=staticfiles
MEDIA_ROOT=media

# ------------------------------------------------------------------------------
# 6. Redis / Cache / Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 7. Security Settings
# ------------------------------------------------------------------------------
# ⚠️  Admin Panel IP Whitelist (comma-separated IPs, empty = no restriction)
# In production, set this to your trusted IPs only:
# ADMIN_ALLOWED_IPS=YOUR_IP_HERE
ADMIN_ALLOWED_IPS=

# ⚠️  CORS Allowed Origins (comma-separated, NO wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ⚠️  Backup Encryption Key (used by security/backup-db.sh)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 8. Bot API Integration (hokimiyatbot)
# ------------------------------------------------------------------------------
# Base URL of the bot's REST API server (running on labirint)
BOT_API_BASE_URL=http://161.97.177.218:8433
# Shared secret key for HMAC authentication (must match bot's API_SECRET_KEY)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
BOT_API_SECRET_KEY=
BOT_API_TIMEOUT=30

# ------------------------------------------------------------------------------
# 9. Production Server Example (Nginx + Gunicorn)
# ------------------------------------------------------------------------------
# If you are deploying to a server (e.g., Ubuntu 22.04), your .env might look like:
#
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=jaysonkhan.com,www.jaysonkhan.com,144.91.69.225
# POSTGRES_HOST=db  (if using docker) or localhost
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# STATIC_ROOT=/var/www/jaysonkhan/static
# MEDIA_ROOT=/var/www/jaysonkhan/media
# ADMIN_URL=jk-secret-control-2026/
# ADMIN_ALLOWED_IPS=YOUR_IP_HERE
# CORS_ALLOWED_ORIGINS=https://jaysonkhan.com,https://www.jaysonkhan.com
# ==============================================================================